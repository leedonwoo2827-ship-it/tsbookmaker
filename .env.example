# ========== TSBookMaker .env (예시) ==========
# 복사: cp .env.example .env  (Windows: copy .env.example .env)
# 그 후 키와 포트를 환경에 맞게 수정

# ----- LLM 라우팅 -----
TSB_LLM_PROVIDER=deepseek                    # deepseek | claude | openai  (UI 드롭다운 디폴트)
TSB_LLM_MODEL_DEEPSEEK=deepseek-v4           # ★ 디폴트 모델 (DeepSeek V4)
TSB_LLM_MODEL_CLAUDE=claude-opus-4-7
TSB_LLM_MODEL_OPENAI=gpt-4o
TSB_LLM_TEMPERATURE=0.3
TSB_LLM_MAX_TOKENS=8000

# ----- API 키 -----
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LITELLM_MASTER_KEY=sk-litellm-master-tsbm

# ----- 포트 (충돌 회피 86xx/76xx/46xx 대역) -----
TSB_UI_PORT=8610                             # Streamlit UI
TSB_LITELLM_PORT=4610                        # LiteLLM proxy
TSB_API_PORT=7613                            # FastAPI 내부 (산출물 다운로드, 선택)
TSB_EMBED_PORT=7611                          # BGE-M3 embedding (선택)
TSB_STT_PORT=7612                            # faster-whisper STT (선택)
TSB_INDEX_PORT=7615                          # 노트북 인덱스 캐시 (선택)

# ----- 경로 -----
TSB_DATA_DIR=./data/notebooks
TSB_ASSETS_DIR=./_assets

# ----- 작업 옵션 -----
TSB_OUTPUT_LANG=ko
TSB_SLIDE_COUNT=30                           # 슬라이드 교안 매수 (기본 30)
TSB_ASSESSMENT_MIN=10                        # 학습평가 최소 문항 수
TSB_ASSESSMENT_MAX=15
TSB_QUIZ_MIN=15                              # 보조 퀴즈 최소 문항 수
TSB_QUIZ_MAX=20
