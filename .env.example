# ========== TSBookMaker .env (선택적) ==========
# 대부분의 사용자는 이 파일을 건드릴 필요가 없습니다.
# API URL/Key/Model 은 앱 좌측 ⚙ 설정 패널에서 입력·저장합니다.
#
# 이 파일은 포트와 작업 옵션(슬라이드 수, 문항 수 등)을 변경할 때만 사용합니다.

# ----- 포트 -----
TSB_UI_PORT=8610                             # Streamlit UI

# ----- 경로 -----
TSB_DATA_DIR=./data/notebooks
TSB_ASSETS_DIR=./_assets

# ----- 작업 옵션 -----
TSB_SLIDE_COUNT=30                           # 슬라이드 교안 매수
TSB_ASSESSMENT_MIN=10                        # 학습평가 최소 문항 수
TSB_ASSESSMENT_MAX=15
TSB_QUIZ_MIN=15                              # 보조 퀴즈 최소 문항 수
TSB_QUIZ_MAX=20

# ----- 고급: API 초기값 (선택) -----
# 아래 변수가 있고 data/user_settings.json 이 아직 없으면 첫 실행 시 자동 채워집니다.
# 일반 사용자는 무시하고 GUI 에서 입력하세요.
# DEEPSEEK_API_BASE=
# DEEPSEEK_API_KEY=
# TSB_LLM_MODEL_DEEPSEEK=deepseek-v4
# TSB_LLM_TEMPERATURE=0.3
# TSB_LLM_MAX_TOKENS=8000
